# Environment Configuration Template
# Copy this to .env or let the application auto-generate secure defaults on first launch.

# Application Environment (development / production)
APP_ENV=development
DEBUG=false

# Security & Sessions (will be auto-generated securely if not present)
# SECRET_KEY=

# Database URL
DATABASE_URL=sqlite:///C:/TeacherSystem/data/teachersystem.db

# Host and Port
HOST=127.0.0.1
PORT=8000

# Session Expiry (hours)
SESSION_EXPIRE_HOURS=24
